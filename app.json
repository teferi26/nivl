{
  "expo": {
    "name": "NIVL",
    "slug": "nivl",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nivl",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "ios": {
      "bundleIdentifier": "com.teferi.nivl",
      "supportsTablet": false,
      "associatedDomains": ["applinks:nivl.app", "applinks:nivl-web.vercel.app"],
      "infoPlist": {
        "NSCameraUsageDescription": "NIVL usa la cámara para las fotos de evidencia de tus misiones, tu diario y tus entrenos. Solo se hace una foto cuando tú lo pides.",
        "NSPhotoLibraryUsageDescription": "NIVL accede a tus fotos para tu retrato y para las imágenes que decidas enviar a tu coach de IA, que las procesa un proveedor de IA externo.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.teferi.nivl",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "nivl.app", "pathPrefix": "/c/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FFFFFF",
          "defaultChannel": "sistema",
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "NIVL usa la cámara para las fotos de evidencia de tus misiones, tu diario y tus entrenos. Solo se hace una foto cuando tú lo pides.",
          "photosPermission": "NIVL accede a tus fotos para tu retrato y para las imágenes que decidas enviar a tu coach de IA, que las procesa un proveedor de IA externo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f40353c9-a94b-441d-a270-1d1c7b8b81bd"
      }
    },
    "owner": "tafatips",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f40353c9-a94b-441d-a270-1d1c7b8b81bd"
    }
  }
}
