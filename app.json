{
  "expo": {
    "name": "NIVL",
    "slug": "nivl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nivl",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060B16",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.teferi.nivl",
      "infoPlist": {
        "NSCameraUsageDescription": "NIVL usa la cámara para registrar evidencias de tus misiones."
      }
    },
    "android": {
      "package": "com.teferi.nivl",
      "adaptiveIcon": {
        "backgroundColor": "#060B16",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "NIVL usa la cámara para registrar evidencias de tus misiones."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060B16",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
