EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx

# Muro de pago. Ausente o distinto de "on" => NIVL es de uso personal: acceso
# premium siempre, cero checkout en la app (evita el rechazo de Apple por la
# Guideline 3.1.1). Ponlo a "on" el día que vuelvas al modelo de suscripción.
EXPO_PUBLIC_PAYWALL=off

# Payment Link de Stripe. Solo se usa si EXPO_PUBLIC_PAYWALL=on.
EXPO_PUBLIC_STRIPE_PAYMENT_LINK=

# SOLO desarrollo: key de IA (OpenAI sk-proj… o Anthropic sk-ant…) que se
# auto-instala en el dispositivo si no hay ninguna guardada. Los builds de
# release la ignoran por completo (guard de __DEV__ en oracle.ts), así que
# nunca acaba embebida en un binario distribuido. Aun así: déjala vacía.
EXPO_PUBLIC_DEFAULT_AI_KEY=

# ── Nota sobre builds de EAS ────────────────────────────────────────
# EAS Build NO sube este .env (está gitignorado). Las variables que el build
# necesita viven en el proyecto de Expo y se inyectan por perfil (eas.json →
# "environment"). Para verlas o cambiarlas:
#   npx eas-cli env:list --environment production
#   npx eas-cli env:set --name X --value Y --environment production
